{
  "dataset_id": "day04_v3_helpdesk_group",
  "dataset_role": "group",
  "description": "Team-authored original IT Helpdesk eval cases: 5 single-turn query cases and 5 multi-turn cases.",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "G01_vpn_check_staging",
      "phase": "B",
      "suite": "base",
      "query": "Dịch vụ VPN ở môi trường staging hiện tại thế nào?",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "check_service_status",
            "args": {
              "service": "vpn",
              "environment": "staging"
            }
          }
        ]
      },
      "metadata": {
        "skill": "environment_arg",
        "difficulty": "medium",
        "what_it_tests": "Trích xuất đúng service=vpn và environment=staging."
      }
    },
    {
      "id": "G02_inspect_desktop",
      "phase": "B",
      "suite": "base",
      "query": "Kiểm tra kết nối mạng ethernet của máy bàn DT-102 giúp tôi.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "inspect_device",
            "args": {
              "asset_id": "DT-102",
              "check": "network"
            }
          }
        ]
      },
      "metadata": {
        "skill": "route_device",
        "difficulty": "easy",
        "what_it_tests": "Gọi inspect_device với check=network cho asset_id DT-102."
      }
    },
    {
      "id": "G03_kb_wifi",
      "phase": "B",
      "suite": "base",
      "query": "Tìm hướng dẫn cách kết nối Wifi SecureGuest trên điện thoại công ty.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "search_kb",
            "args": {
              "category": "network"
            }
          }
        ]
      },
      "metadata": {
        "skill": "route_howto",
        "difficulty": "medium",
        "what_it_tests": "Tìm hướng dẫn wifi trong knowledge base category network."
      }
    },
    {
      "id": "G04_user_lookup_hung",
      "phase": "B",
      "suite": "base",
      "query": "Tra thông tin tài khoản nhân viên EMP-1005 và các thiết bị được gán.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "lookup_user",
            "args": {
              "employee_id": "EMP-1005"
            }
          }
        ]
      },
      "metadata": {
        "skill": "route_employee",
        "difficulty": "easy",
        "what_it_tests": "Tra cứu nhân viên bằng employee_id."
      }
    },
    {
      "id": "G05_out_of_scope_weather",
      "phase": "B",
      "suite": "base",
      "query": "Hôm nay thời tiết Hà Nội thế nào?",
      "failure_type": "out_of_scope",
      "expect": {
        "no_tool": true,
        "behavior": "refuse"
      },
      "metadata": {
        "skill": "out_of_scope",
        "difficulty": "easy",
        "what_it_tests": "Từ chối trả lời và không gọi tool cho yêu cầu ngoài IT helpdesk."
      }
    },
    {
